{
  "mcpServers": {
    "mysql-mcp": {
      "_comment_paths": "Paths assume local client execution without Docker.",
      "_comment_timeout": "Client-side timeout is specified in seconds (unofficial client-specific extension, remove if validation fails).",
      "command": "npx",
      "args": [
        "-y",
        "@neverinfamous/mysql-mcp",
        "--transport",
        "stdio"
      ],
      "timeout": 600,
      "env": {
        "MYSQL_HOST": "localhost",
        "MYSQL_PORT": "3306",
        "MYSQL_USER": "mcp_user",
        "MYSQL_PASSWORD": "secure_password",
        "MYSQL_DATABASE": "testdb",
        "MYSQL_POOL_SIZE": "10",
        "_comment_TOOL_FILTER": "Use 'codemode' for maximum token efficiency, or 'starter' for the default bundle.",
        "TOOL_FILTER": "codemode",
        "ALLOWED_IO_ROOTS": "C:/temp/mcp-sandbox,/tmp/mcp-sandbox",
        "METADATA_CACHE_TTL_MS": "30000",
        "CODEMODE_MAX_RESULT_SIZE": "102400",
        "_comment_AUDIT_LOG_PATH": "This configures the metrics exporter's read-path. --audit-log <path> or config file is required to enable the server's write-path.",
        "AUDIT_LOG_PATH": "C:/temp/mcp-sandbox/mcp-audit.jsonl",
        "_comment_rate_limiting": "If Redis is omitted, rate limiting safely falls back to in-memory mode. Note: MCP_RATE_LIMIT_MAX is intentionally elevated for example purposes (default is 100).",
        "MCP_RATE_LIMIT_MAX": "10000",
        "CODEMODE_RATE_LIMIT_MAX": "60",
        "MYSQL_XPORT": "33060",
        "MYSQLSH_PATH": "mysqlsh",
        "CODEMODE_ISOLATION": "isolate",
        "LOG_LEVEL": "info",
        "_comment_advanced": "Ecosystem variables should only be added manually if the corresponding local services are active. Ensure you rename keys to remove the _comment_ prefix.",
        "_comment_REDIS_URL": "redis://localhost:6379",
        "_comment_MYSQL_ROUTER_URL": "https://localhost:8443",
        "_comment_MYSQL_ROUTER_USER": "rest_api",
        "_comment_MYSQL_ROUTER_PASSWORD": "router_password",
        "_comment_MYSQL_ROUTER_INSECURE": "true",
        "_comment_MYSQL_ROUTER_API_VERSION": "/api/20190715",
        "_comment_PROXYSQL_HOST": "localhost",
        "_comment_PROXYSQL_PORT": "6032",
        "_comment_PROXYSQL_USER": "radmin",
        "_comment_PROXYSQL_PASSWORD": "radmin",
        "_comment_http_server_options": "--- Optional HTTP server settings (not typically used for stdio clients) ---",
        "_comment_MCP_AUTH_TOKEN": "your-secure-auth-token",
        "_comment_MCP_HOST": "127.0.0.1",
        "_comment_TRUST_PROXY": "false",
        "_comment_MCP_ENABLE_HSTS": "false",
        "_comment_MYSQLMCP_PORT": "3000",
        "_comment_PROMETHEUS_PORT": "9090",
        "_comment_GRAFANA_PORT": "3001",
        "_comment_DD_API_KEY": "your_api_key",
        "_comment_DD_APP_KEY": "your_app_key",
        "_comment_DD_HOSTNAME": "<your_hostname>",
        "_comment_DD_SITE": "datadoghq.com",
        "_comment_OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4318",
        "_comment_DD_EXTRA_PERFORMANCE_METRICS": "false",
        "_comment_MCP_METRICS_EXPORT": "prometheus",
        "_comment_OAUTH_ENABLED": "false",
        "_comment_OAUTH_ISSUER": "https://auth.example.com",
        "_comment_OAUTH_AUDIENCE": "mysql-mcp-client",
        "_comment_OAUTH_JWKS_URI": "https://auth.example.com/.well-known/jwks.json",
        "_comment_OAUTH_CLOCK_TOLERANCE": "60"
      }
    }
  }
}
