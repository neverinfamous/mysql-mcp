{
  "mcpServers": {
    "mysql-mcp": {
      "_comment_paths": "Paths assume local client execution without Docker.",
      "_comment_timeout": "Client-side timeout is specified in seconds.",
      "command": "npx",
      "args": [
        "-y",
        "@neverinfamous/mysql-mcp",
        "--transport",
        "stdio"
      ],
      "timeout": 600,
      "env": {
        "MCP_REQUEST_TIMEOUT": "600000",
        "MYSQL_HOST": "localhost",
        "MYSQL_PORT": "3306",
        "MYSQL_USER": "mcp_user",
        "MYSQL_PASSWORD": "secure_password",
        "MYSQL_DATABASE": "testdb",
        "MYSQL_POOL_SIZE": "10",
        "TOOL_FILTER": "starter",
        "ALLOWED_IO_ROOTS": "C:/temp/mcp-sandbox,/tmp/mcp-sandbox",
        "METADATA_CACHE_TTL_MS": "30000",
        "CODE_MODE_MAX_RESULT_SIZE": "102400",
        "AUDIT_LOG_PATH": "/tmp/mcp-sandbox/audit.jsonl",
        "_comment_rate_limiting": "If Redis is omitted, rate limiting safely falls back to in-memory mode.",
        "MCP_RATE_LIMIT_MAX": "10000",
        "CODEMODE_RATE_LIMIT_MAX": "60",
        "MYSQL_XPORT": "33060",
        "MYSQLSH_PATH": "mysqlsh",
        "CODEMODE_ISOLATION": "sandbox",
        "LOG_LEVEL": "info",
        "_comment_advanced": "Ecosystem variables should only be added manually if the corresponding local services are active.",
        "_comment_REDIS_URL": "redis://localhost:6379",
        "_comment_OAUTH_ENABLED": "false",
        "_comment_OAUTH_ISSUER": "https://auth.example.com",
        "_comment_OAUTH_AUDIENCE": "mysql-mcp-client",
        "_comment_OAUTH_JWKS_URI": "https://auth.example.com/.well-known/jwks.json",
        "_comment_OAUTH_CLOCK_TOLERANCE": "60",
        "_comment_MYSQL_ROUTER_URL": "https://localhost:8443",
        "_comment_MYSQL_ROUTER_USER": "rest_api",
        "_comment_MYSQL_ROUTER_PASSWORD": "password",
        "_comment_MYSQL_ROUTER_INSECURE": "true",
        "_comment_PROXYSQL_HOST": "localhost",
        "_comment_PROXYSQL_PORT": "6032",
        "_comment_PROXYSQL_USER": "radmin",
        "_comment_PROXYSQL_PASSWORD": "radmin",
        "_comment_HTTP_VARS": "The following variables are only applicable for HTTP transport",
        "_comment_MCP_HEADERS_TIMEOUT": "5000",
        "_comment_MCP_METRICS_EXPORT": "prometheus",
        "_comment_TRUST_PROXY": "false",
        "_comment_MCP_ENABLE_HSTS": "false",
        "_comment_MCP_AUTH_TOKEN": "your-secure-auth-token"
      }
    }
  }
}
