                "comparator": "\u003e=",
                "custom_bg_color": "#133a09",
                "palette": "custom_bg",
                "value": 0.0
              }
            ],
            "formulas": [
              {
                "formula": "query1"
              }
            ],
            "queries": [
              {
                "aggregator": "sum",
                "data_source": "metrics",
                "name": "query1",
                "query": "sum:mysql_mcp.mysql_mcp_tool_tokens.count{$tool}.as_count().rollup(sum)"
              }
            ],
            "response_format": "scalar"
          }
        ],
        "title": "Total Tokens",
        "title_align": "left",
        "title_size": "16",
