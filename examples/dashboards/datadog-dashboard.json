                "data_source": "metrics",
                "name": "errors",
                "query": "sum:mysql_mcp.mysql_mcp_tool_errors.count{$tool}.as_count().rollup(sum)"
              },
              {
                "data_source": "metrics",
                "name": "old_calls",
                "query": "sum:mysql_mcp.mysql_mcp_tool_calls.count{$tool}.as_count().rollup(sum)"
              },
              {
                "data_source": "metrics",
                "name": "old_errors",
                "query": "sum:mysql_mcp.mysql_mcp_tool_errors.count{$tool}.as_count().rollup(sum)"
              }
            ],
            "response_format": "timeseries",
            "style": {
              "line_type": "solid",
              "line_width": "normal",
              "palette": "green"
            }
          }
        ],
        "show_legend": true,
