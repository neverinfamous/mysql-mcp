{
  "description": "AI Efficiency metrics for mysql-mcp server (Opus 4.8 Standard pricing)\n\n*Note: Datadog automatically formats values less than 0.01 in scientific notation. During low-traffic periods, micro-costs may appear in scientific format (e.g., 5e-5 $) until the accumulated cost exceeds $0.01.*",
  "layout_type": "ordered",
  "notify_list": [],
  "pause_auto_refresh": null,
  "reflow_type": "fixed",
  "template_variables": [],
  "title": "MySQL-MCP AI Efficiency",
