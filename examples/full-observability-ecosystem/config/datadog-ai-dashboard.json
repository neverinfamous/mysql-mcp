      "definition": {
        "autoscale": true,
        "precision": 2,
        "requests": [
          {
            "aggregator": "sum",
            "conditional_formats": [
              {
                "comparator": ">=",
                "custom_bg_color": "#0b4107",
                "palette": "custom_bg",
                "value": 0
              }
            ],
            "formulas": [
              {
                "formula": "default_zero(query1)"
              }
            ],
            "queries": [
              {
                "aggregator": "sum",
                "data_source": "metrics",
                "name": "query1",
                "query": "sum:mysql_mcp.mysql_mcp_tool_tokens_total{*}.rollup(sum, 60)"
              }
            ],
            "response_format": "scalar"
          }
        ],
        "title": "Total Tokens Used",
