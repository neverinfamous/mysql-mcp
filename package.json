{
  "name": "@neverinfamous/mysql-mcp",
  "version": "5.1.1",
  "description": "Enterprise-grade MySQL MCP Server with OAuth 2.1 authentication, connection pooling & tool filtering",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mysql-mcp": "dist/cli.js"
  },
  "scripts": {
    "build": "pnpm run build:js && pnpm run build:types",
    "build:js": "tsup",
    "build:types": "tsc --project tsconfig.json --emitDeclarationOnly",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm exec tsx test-server/infrastructure/scripts/cleanup-ports.ts && playwright test",
    "test:badges": "tsx test-server/infrastructure/scripts/update-badges.ts",
    "test:zod": "node scripts/test-zod-errors.mjs",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run test:coverage && pnpm run test:e2e && pnpm run test:badges",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "generate:instructions": "tsx scripts/generate-server-instructions.ts",
    "generate:code-map": "tsx scripts/update-code-map.ts",
    "generate:tests": "bun test-server/scripts/generate-tests.ts",
    "heal:cluster": "bun test-server/infrastructure/scripts/heal-cluster.ts",
    "bench": "vitest bench --run",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "mcp",
    "mysql",
    "database",
    "model-context-protocol",
    "ai",
    "llm",
    "claude",
    "cursor",
    "oauth",
    "typescript"
  ],
  "author": "neverinfamous",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neverinfamous/mysql-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/neverinfamous/mysql-mcp/issues"
  },
  "homepage": "https://github.com/neverinfamous/mysql-mcp#readme",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.9.0",
  "dependencies": {
    "@modelcontextprotocol/core": "^2.4.0",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@opentelemetry/api": "^1.10.0",
    "acorn": "^8.19.0",
    "better-sqlite3": "npm:better-sqlite3-multiple-ciphers@^13.0.3",
    "isolated-vm": "7.0.2",
    "jose": "^6.2.15",
    "mysql2": "^3.24.6",
    "picocolors": "^1.1.1",
    "redis": "^6.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "dotenv": "^18.0.9",
    "esbuild": "0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "mdast-util-from-markdown": "^2.1.0",
    "ts-morph": "^28.0.0",
    "ts-pattern": "^5.9.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "unist-util-visit": "^5.2.0",
    "vitest": "^5.1.0"
  },
  "resolutions": {
    "@hono/node-server": "2.1.6",
    "hono": "4.13.16",
    "esbuild": "0.28.2",
    "brace-expansion": "5.0.12",
    "ip-address": "10.7.6",
    "undici": "8.12.4",
    "postcss": "8.5.32",
    "fast-uri": "4.2.3",
    "minimatch": "11.0.4",
    "glob": "14.0.3",
    "tar": "7.5.22",
    "vite": "8.3.6"
  },
  "overrides": {
    "@hono/node-server": "2.1.6",
    "hono": "4.13.16",
    "esbuild": "0.28.2",
    "brace-expansion": "5.0.12",
    "ip-address": "10.7.6",
    "undici": "8.12.4",
    "postcss": "8.5.32",
    "fast-uri": "4.2.3",
    "minimatch": "11.0.4",
    "glob": "14.0.3",
    "tar": "7.5.22",
    "vite": "8.3.6"
  }
}
