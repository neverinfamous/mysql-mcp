{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2024-11-05/server.schema.json",
  "name": "io.github.neverinfamous/mysql-mcp",
  "title": "MySQL MCP Server",
  "description": "Streamline database operations with our Enterprise-grade MySQL MCP Server. Securely connect using OAuth 2.1. Boost token efficiency via Code Mode.",
  "version": "4.0.0",
  "packages": [
    {
      "registryType": "oci",
      "identifier": "docker.io/writenotenow/mysql-mcp:latest",
      "args": [
        "--transport",
        "stdio"
      ],
      "transport": {
        "type": "stdio"
      }
    },
    {
      "registryType": "npm",
      "identifier": "@neverinfamous/mysql-mcp",
      "args": [
        "--transport",
        "stdio"
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "keywords": [
    "mcp",
    "mysql",
    "database",
    "model-context-protocol",
    "oauth",
    "docker",
    "codemode",
    "ai",
    "llm",
    "claude",
    "cursor",
    "typescript"
  ],
  "author": {
    "name": "neverinfamous"
  },
  "homepage": "https://github.com/neverinfamous/mysql-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/neverinfamous/mysql-mcp.git"
  },
  "license": "MIT"
}
