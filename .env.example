# Centralized, type-safe configuration for enterprise MySQL MCP deployment.
# Note: mcp-config-example.json is for client config.
# Note: Advanced configuration (CORS, SSL, granular connection pooling) requires using a server-config.json/server-config.yaml file instead of this .env file.

# Database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=mcp_user
MYSQL_PASSWORD=secure_password
MYSQL_DATABASE=testdb
# Note: MYSQL_ROOT_PASSWORD is strictly for initializing Docker database infrastructure, not a server property.
MYSQL_ROOT_PASSWORD=secure_root_password
# Connection Pool
MYSQL_POOL_SIZE=10

# Tool Filtering (e.g., starter, essential, dba-manage, etc.)
TOOL_FILTER=codemode

# Server
# Server Transport & Architecture
# STATELESS requires using a server-config.json/server-config.yaml file or CLI flags instead of this .env file.
MYSQLMCP_PORT=3000
# Docker mapping requirements: set MCP_HOST to 0.0.0.0 and adjust ALLOWED_IO_ROOTS to match mounted volumes.
MCP_HOST=127.0.0.1
MCP_ENABLE_HSTS=false
TRUST_PROXY=false
MCP_METRICS_EXPORT=prometheus
ALLOWED_IO_ROOTS=C:/temp/mcp-sandbox,/tmp/mcp-sandbox
MCP_AUTH_TOKEN=your-secure-auth-token
AUDIT_LOG_PATH=/var/log/mysql-mcp/mcp-audit.jsonl 
# Note: Grafana Alloy routes to Loki. The Exporter isolates writes via --audit-log exporter-audit.jsonl.
# The metrics server and exporter share the same process on port 3000.

# Observability & Docker Compose Sidecars
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3001
# DD_API_KEY=your_api_key
# DD_APP_KEY=your_app_key
# DD_HOSTNAME=adamic-wsl2
# DD_SITE=datadoghq.com
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# DD_EXTRA_PERFORMANCE_METRICS=false
METADATA_CACHE_TTL_MS=30000
CODEMODE_MAX_RESULT_SIZE=102400
# Distributed Redis-backed rate limiting for the HTTP Transport layer and Code Mode
# If Redis is omitted, rate limiting safely falls back to in-memory mode.
# Note: MCP_RATE_LIMIT_MAX is intentionally elevated for example purposes (default is 100).
# REDIS_URL=redis://localhost:6379
MCP_RATE_LIMIT_MAX=10000
CODEMODE_RATE_LIMIT_MAX=60

# OAuth
OAUTH_ENABLED=false
OAUTH_ISSUER=https://auth.example.com
OAUTH_AUDIENCE=mysql-mcp-client
OAUTH_JWKS_URI=https://auth.example.com/.well-known/jwks.json
OAUTH_CLOCK_TOLERANCE=60

# Advanced & Ecosystem
# MYSQL_ROUTER_URL=https://localhost:8443
# MYSQL_ROUTER_USER=rest_api
# MYSQL_ROUTER_PASSWORD=password
# MYSQL_ROUTER_INSECURE=true
# MYSQL_ROUTER_API_VERSION=/api/20190715
# PROXYSQL_HOST=localhost
# PROXYSQL_PORT=6032
# PROXYSQL_USER=radmin
# PROXYSQL_PASSWORD=radmin
MYSQLSH_PATH=mysqlsh
MYSQL_XPORT=33060
CODEMODE_ISOLATION=isolate
LOG_LEVEL=info
