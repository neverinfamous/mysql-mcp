{
  "description": "Deep dive into tool latencies, bottlenecks, and error classification.",
  "layout_type": "ordered",
  "notify_list": [],
  "pause_auto_refresh": null,
  "reflow_type": "fixed",
  "template_variables": [
    {
      "available_values": [],
      "default": "*",
