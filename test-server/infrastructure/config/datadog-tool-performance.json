  "title": "datadog-tool-performance",
  "widgets": [
    {
      "definition": {
        "has_search_bar": "never",
        "requests": [
          {
            "formulas": [
              {
                "cell_display_mode": "bar",
                "formula": "top(calls * latency, 10, 'sum', 'desc')"
              }
            ],
            "queries": [
              {
                "data_source": "metrics",
                "name": "calls",
                "query": "sum:mysql_mcp.mysql_mcp_tool_calls.count{*} by {tool}.as_count().rollup(sum)"
              },
              {
                "data_source": "metrics",
                "name": "latency",
                "query": "avg:mysql_mcp.mysql_mcp_tool_latency_ms_p50{*} by {tool}.rollup(avg)"
              }
            ],
            "response_format": "scalar",
            "sort": {
              "order_by": [
                {
                  "index": 0,
                  "order": "desc",
                  "type": "formula"
                }
              ]
            }
          }
        ],
        "title": "Optimization Target (Total Gross Latency)",
        "title_align": "left",
        "title_size": "16",
        "type": "query_table"
      },
