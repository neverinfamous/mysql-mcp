    {
      "definition": {
        "anomaly_detection": {
          "detection_sensitivity": "never_detect"
        },
        "description": "Note: This captures all errors across all tools. The Error Logs widget only displays audited errors (Writes/Admin) unless the server is started with theÃ‚Â `--audit-reads`Ã‚Â flag.",
        "legend_layout": "auto",
        "markers": [
          {
            "display_type": "ok dashed",
            "label": "Zero baseline",
            "value": "y = 0"
          }
        ],
        "requests": [
          {
            "display_type": "line",
            "formulas": [
              {
                "alias": "Total Calls",
                "formula": "default_zero(calls) + default_zero(old_calls)"
              },
              {
                "alias": "Total Errors",
                "formula": "default_zero(errors) + default_zero(old_errors)"
              }
            ],
            "queries": [
              {
                "data_source": "metrics",
                "name": "calls",
                "query": "sum:mysql_mcp.mysql_mcp_tool_calls.count{$tool}.as_count().rollup(sum)"
              },
              {
                "data_source": "metrics",
                "name": "errors",
                "query": "sum:mysql_mcp.mysql_mcp_tool_errors.count{$tool}.as_count().rollup(sum)"
              },
              {
                "data_source": "metrics",
                "name": "old_calls",
                "query": "sum:mysql_mcp.mysql_mcp_tool_calls.count{$tool}.as_count().rollup(sum)"
              },
              {
                "data_source": "metrics",
                "name": "old_errors",
                "query": "sum:mysql_mcp.mysql_mcp_tool_errors.count{$tool}.as_count().rollup(sum)"
              }
            ],
            "response_format": "timeseries",
            "style": {
              "line_type": "solid",
              "line_width": "normal",
              "palette": "green"
            }
          }
        ],
        "show_legend": true,
        "title": "Calls Vs Errors",
        "title_align": "left",
        "title_size": "16",
        "type": "timeseries",
        "yaxis": {
          "include_zero": true,
          "scale": "linear"
        }
